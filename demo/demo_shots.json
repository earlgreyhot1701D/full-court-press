    {
      "action": "scroll_to",
      "selector": ".recap",
      "offset": 260,
      "pause": 6500
    },
    {
      "action": "click",
      "selector": ".voices[aria-label=\"Voice\"] a:text-is(\"The Film Room\")",
      "pause": 800
    },
    {
      "action": "scroll_to",
      "selector": ".recap",
      "offset": 260,
      "pause": 6000
    },
    {
      "action": "click",
      "selector": ".voices[aria-label=\"Edition\"] a:text-is(\"Tempo edition\")",
      "pause": 800
    },
    {
      "action": "scroll_to",
      "selector": ".recap",
      "offset": 260,
      "pause": 6500
